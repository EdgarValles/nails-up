[Unit]
Description=Nails Up portal
After=network-online.target
Wants=network-online.target

[Service]
User=nailsup
Group=nailsup
WorkingDirectory=/opt/nails-up
EnvironmentFile=/opt/nails-up/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
